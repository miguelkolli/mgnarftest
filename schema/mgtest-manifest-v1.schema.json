{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miguelkolli/mgnarftest/schema/mgtest-manifest-v1.schema.json",
  "title": "MGnarfTest manifest v1",
  "type": "object",
  "required": ["schema_version", "test_id", "test_version", "status", "target", "purpose", "expected", "execution", "limits", "review", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "test_id": {"type": "string", "pattern": "^MGTEST-[A-Z0-9]+-[A-Z0-9-]+-[0-9]{3}$"},
    "test_version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["PROPOSED", "REVIEW-A", "REVIEW-B", "STABLE", "BLOCKED", "REJECTED", "NEEDS-REVISION"]},
    "target": {
      "type": "object",
      "required": ["project", "repository", "release", "commit"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "release": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "purpose": {"type": "string", "minLength": 10},
    "expected": {
      "type": "object",
      "required": ["allowed_results", "safe_condition"],
      "properties": {
        "allowed_results": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["PASS", "FAIL", "BLOCKED", "UNVERIFIED", "LIMITATION_CONFIRMED"]}
        },
        "safe_condition": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["entrypoint", "network", "privileges", "external_dependencies"],
      "properties": {
        "entrypoint": {"type": "string", "minLength": 1},
        "network": {"type": "boolean"},
        "privileges": {"type": "string", "minLength": 1},
        "external_dependencies": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "review": {
      "type": "object",
      "required": ["author", "reviewer_a", "reviewer_b", "promotion_pr"],
      "properties": {
        "author": {"type": ["string", "null"]},
        "reviewer_a": {"type": ["string", "null"]},
        "reviewer_b": {"type": ["string", "null"]},
        "promotion_pr": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["result", "run_id", "artifact_hash", "receipt_sha256", "mgtest_commit", "target_commit"],
      "properties": {
        "result": {"enum": ["PASS", "FAIL", "BLOCKED", "UNVERIFIED", "LIMITATION_CONFIRMED"]},
        "run_id": {"type": ["string", "null"]},
        "artifact_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "mgtest_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "target_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
